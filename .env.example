# SentinelRS Configuration

PORT=8080
DATABASE_URL=postgres://sentinel:sentinelpassword@localhost:5432/sentinelrs
RUST_LOG=info,sentinel_server=debug,sentinel_ingest=debug

# AWS Integration Settings (Read-Only)
# Leave unset or empty to run in Demo / Synthetic Mode
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default
CLOUDTRAIL_POLL_INTERVAL_SECONDS=10
